# Copy to .env (which is git-ignored) and fill in real values.

# 데이터베이스 설정
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-db-password
DB_NAME=sinbee

# Flask 보안 설정
SECRET_KEY=replace-with-a-random-32-byte-secret
FLASK_ENV=development  # development 또는 production
FLASK_DEBUG=True  # 프로덕션에서는 False로 설정

# 세션 설정 (app_instance.py에서 자동 설정되므로 참고용)
SESSION_COOKIE_SECURE=False  # 프로덕션에서는 True로 설정
SESSION_COOKIE_HTTPONLY=True  # JavaScript 접근 차단
SESSION_COOKIE_SAMESITE=Strict  # CSRF 방지 (Lax → Strict로 강화)
PERMANENT_SESSION_LIFETIME=3600  # 세션 만료 1시간

# 파일 업로드 설정
MAX_CONTENT_LENGTH=10485760  # 10MB
UPLOAD_FOLDER=/tmp/uploads

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
